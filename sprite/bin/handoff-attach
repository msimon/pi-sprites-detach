#!/bin/bash
# handoff-attach <jobId>: attach this terminal to a joined pi. Run by the laptop as
# `sprite exec -s <sprite> --tty -- ~/.pi-handoff/sprite/bin/handoff-attach <jobId>`
# after handoff-join. Closing the terminal detaches: pi keeps going until it is idle
# and nobody is attached, then quits.
set -uo pipefail
# shellcheck source=lib.sh
source "$(dirname "$(readlink -f "$0")")/lib.sh"

job=${1:?usage: handoff-attach <jobId>}
session=$(join_session "$job")
export TERM=${TERM:-xterm-256color}
if ! tmux has-session -t "=$session" 2>/dev/null; then
  echo "pi-handoff: $job has no joined pi on this Sprite (it quits once idle with nobody attached)."
  echo "Run /handoff join $job again."
  exit 1
fi
exec tmux attach-session -t "=$session"
