#!/bin/bash
# detach-start <jobId>: start a run of the job as the Sprite service detach-<jobId>.
#
# The runtime owns the process: it outlives the exec that started it, and the runtime
# starts it again if the Sprite environment restarts or the runner is killed. The run
# deletes the service when it ends (detach-run), as does an abort (detach-stop).
# Callers check first that no run is in progress (runner_alive).
set -uo pipefail
# shellcheck source=lib.sh
source "$(dirname "$(readlink -f "$0")")/lib.sh"

job=${1:?usage: detach-start <jobId>}
service_delete "$job"   # a definition left behind by an earlier run
"$SPRITE_ENV" services create "detach-$job" --cmd "$DETACH_HOME/bin/detach-run" --args "$job" --no-stream >/dev/null
