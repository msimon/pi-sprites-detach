#!/bin/bash
# detach-join <jobId> [--abort] [-- pi args...]: start interactive pi on a job's
# conversation, in the tmux session detach-<jobId> (/attach). The laptop then
# attaches with detach-attach over `sprite exec --tty`. One small JSON result:
#   {joined:"started"|"already", status}   pi is running in the session
#   {refused:"running", status}            a headless run is in progress (no --abort)
#   {missing:true}                         no such job on this Sprite
# --abort stops the headless run first (detach-stop). Starting a joined pi needs the
# job's checkout, so a job must have run once (every detached job has). Arguments
# after `--` go to pi (a model, say).
set -uo pipefail
# shellcheck source=lib.sh
source "$(dirname "$(readlink -f "$0")")/lib.sh"

job=${1:?usage: detach-join <jobId> [--abort] [-- pi args...]}
shift
abort=
if [ "${1:-}" = --abort ]; then abort=--abort; shift; fi
[ "${1:-}" = -- ] && shift
dir=$DETACH_STATE/$job
status=$dir/status.json
session=$(join_session "$job")
[ -f "$dir/job.json" ] || { emit '{"missing":true}'; exit 0; }

fix_stale_joined "$job"
if tmux has-session -t "=$session" 2>/dev/null; then
  emit "$(jq -c '{joined:"already", status:.}' "$status")"
  exit 0
fi
if runner_alive "$job"; then
  if [ "$abort" != --abort ]; then
    emit "$(jq -c '{refused:"running", status:.}' "$status")"
    exit 0
  fi
  "$DETACH_HOME/bin/detach-stop" "$job" >/dev/null || { echo "could not stop $job" >&2; exit 1; }
fi

# A wide default size until a client attaches; tmux then follows the client's size.
# No status bar: the pane should look like pi on the laptop.
tmux new-session -d -s "$session" -x 200 -y 50 "$DETACH_HOME/bin/detach-joined" "$job" "$@" || exit 1
tmux set-option -t "$session" status off >/dev/null
for _ in $(seq 50); do
  [ "$(jq -r '.state // empty' "$status" 2>/dev/null)" = joined ] && break
  tmux has-session -t "=$session" 2>/dev/null || break
  sleep 0.2
done
if [ "$(jq -r '.state // empty' "$status" 2>/dev/null)" != joined ]; then
  echo "pi did not start for $job; see $dir/runner.log" >&2
  exit 1
fi
emit "$(jq -c '{joined:"started", status:.}' "$status")"
