#!/bin/bash
# detach-reply <jobId> <promptFile>: start another run of a job whose run has ended.
#
# The laptop uploads the reply to <promptFile> (under ~/.detach/incoming/, so a job
# that no longer exists does not get a stray folder). Refuses while a run is in
# progress. The new run reuses the job's checkout and session file: pi reads the whole
# history and takes the reply as the next user message.
set -uo pipefail
# shellcheck source=lib.sh
source "$(dirname "$(readlink -f "$0")")/lib.sh"

job=${1:?usage: detach-reply <jobId> <promptFile>}
prompt=${2:?usage: detach-reply <jobId> <promptFile>}
dir=$DETACH_STATE/$job

if [ ! -f "$dir/job.json" ]; then
  rm -f "$prompt"
  emit '{"missing":true}'
  exit 0
fi
if runner_alive "$job"; then
  rm -f "$prompt"
  emit "$(jq -c '{refused:"running", status:.}' "$dir/status.json")"
  exit 0
fi

mv "$prompt" "$dir/prompt.txt" || exit 1
# `starting` tells detach-run this is a new run, not one to resume.
json_merge "$dir/status.json" '{"state":"starting"}'
"$DETACH_HOME/bin/detach-start" "$job" || exit 1
emit '{"started":true}'
