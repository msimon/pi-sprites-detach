#!/bin/bash
# handoff-joined <jobId> [pi args...]: interactive pi on a job's conversation, for
# /handoff join. Runs as the only program of the tmux session handoff-<jobId>
# (handoff-join starts it), so the session closes when this script exits.
#
# Same namespace and session file as handoff-run, but interactive: pi draws in the
# tmux pane, and the user types through `tmux attach` (handoff-attach). The remote
# extension sees HANDOFF_JOINED: the briefing says the user is present, and pi quits
# on its own once it is idle and no client is attached. The job is `joined` while
# this runs (runner.pid is this script, so reply, pull and a new join see a run in
# progress); when pi exits, the job is `done` with pi's last answer, or `needs_input`
# if the agent asked something nobody answered, or `aborted` (handoff-stop).
# Not a Sprite service: a joined pi cannot resume without the user, so after an
# environment restart the job is recorded `done` (fix_stale_joined) and joining again
# starts a fresh pi on the same conversation.
set -uo pipefail
# shellcheck source=lib.sh
source "$(dirname "$(readlink -f "$0")")/lib.sh"

job=${1:?usage: handoff-joined <jobId> [pi args...]}
shift
dir=$HANDOFF_STATE/$job
job_json=$dir/job.json
status=$dir/status.json
log=$dir/runner.log
[ -f "$job_json" ] || { echo "handoff-joined: no job $job" >&2; sleep 5; exit 2; }

note() { echo "== $(now) $*" >>"$log"; }
get() { jq -r "$1 // empty" "$job_json"; }
folder=$(get .folder)
mount_at=$(get .mountAt)
checkout=$(get .checkout)

if [ ! -d "$checkout" ]; then
  echo "pi-handoff: the job's checkout is missing ($checkout); reply to the job once to prepare it." >&2
  sleep 5
  exit 1
fi

pid_record $$ "$dir/runner.pid"
note "handoff-joined $job (pid $$)"
hold_start "handoff-$job" "$job"

rc=
on_exit() {
  local state question text error
  trap - EXIT TERM INT HUP
  if [ -e "$dir/stop" ]; then
    state=aborted
  elif [ -s "$dir/question.json" ]; then
    state=needs_input
  elif [ -n "$rc" ] && [ "$rc" -gt 0 ] && [ "$rc" -lt 128 ]; then
    state=error
  else
    state=done
  fi
  question=null
  [ "$state" = needs_input ] && question=$(cat "$dir/question.json")
  text=null
  [ -s "$dir/result.json" ] && text=$(jq '.text // null' "$dir/result.json")
  error=null
  [ "$state" = error ] && error=$(jq -n --arg rc "$rc" '"pi exited with code \($rc) while joined"')
  json_merge "$status" "$(jq -n --arg s "$state" --arg t "$(now)" --argjson rc "${rc:-null}" \
    --argjson q "$question" --argjson x "$text" --argjson e "$error" \
    '{state:$s, runEndedAt:$t, exitCode:$rc, question:$q, lastAssistantText:$x, error:$e}')"
  note "joined pi ended: $state"
  rm -f "$dir/runner.pid"
  hold_stop
}
trap on_exit EXIT
# A signal (handoff-stop, or tmux killing the session) waits for pi to exit, then the
# EXIT trap records the outcome.
trap 'exit 143' TERM INT HUP

rm -f "$dir/question.json" "$dir/result.json" "$dir/stop"
json_merge "$status" "$(jq -n --arg j "$job" --arg t "$(now)" \
  '{jobId:$j, state:"joined", runStartedAt:$t, runEndedAt:null, exitCode:null, error:null, question:null, lastAssistantText:null, interruptions:0}')"

# As in handoff-run: root only for the namespace and the bind mount, then back to this
# user; sudo resets the environment, so pass it explicitly (TERM for the TUI).
inner='mkdir -p "$1" && mount --bind "$2" "$1" && cd "$3" && u=$4 g=$5 && shift 5 &&
  exec setpriv --reuid="$u" --regid="$g" --init-groups "$@"'
sudo unshare --mount --propagation private -- bash -c "$inner" handoff \
  "$mount_at" "$checkout" "$folder" "$(id -u)" "$(id -g)" \
  env HOME="$HOME" USER="$(id -un)" PATH="$PATH" LANG="$LANG" LC_ALL="$LC_ALL" \
  TERM="${TERM:-xterm-256color}" COLORTERM="${COLORTERM:-truecolor}" \
  HANDOFF_JOB_ID="$job" HANDOFF_DIR="$dir" HANDOFF_JOINED=1 HANDOFF_TMUX="$(join_session "$job")" \
  pi --session "$dir/session.jsonl" -e "$HANDOFF_HOME/extension/index.ts" "$@"
rc=$?
note "pi exit $rc"
