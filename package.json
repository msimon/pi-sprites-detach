{
  "name": "@msimon/pi-sprites-detach",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Detach a pi conversation to a Fly.io Sprite, keep it running unattended, get notified, attach to it or pull it back.",
  "author": "Marc Simon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msimon/pi-sprites-detach.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "sprites"
  ],
  "pi": {
    "extensions": [
      "./src/local/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.36",
    "typescript": "^5.9.3"
  }
}
